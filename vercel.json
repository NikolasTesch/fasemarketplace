{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build --workspace @fasemarketplace/web",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/health/ready.mjs": { "maxDuration": 20 },
    "api/access/**/*.mjs": { "maxDuration": 20 },
    "api/business.mjs": { "maxDuration": 20 }
  },
  "rewrites": [
    { "source": "/api/catalog/:path*", "destination": "/api/business?fm_path=catalog/:path*" },
    { "source": "/api/inventory/:path*", "destination": "/api/business?fm_path=inventory/:path*" }
  ]
}
