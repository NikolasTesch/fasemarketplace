# Copie para .env.production; nunca para .env/.env.local.
# Uso explícito: docker compose --env-file .env.production -p fasemarketplace-production -f compose.production.yaml ...
# Não reutilize conexão ou chave de development. Somente valores fictícios neste modelo.
COMPOSE_PROJECT_NAME=fasemarketplace-production
PRODUCTION_IMAGE=fasemarketplace-production:configure-release
APP_RELEASE=configure-release

# Neon: projeto confirmado > branch production > Connect > pooling ON.
# Role exclusiva fasemarketplace_production_app; banco neondb; TLS verify-full.
# A aplicação confere este host contra o endpoint aprovado na SPEC-006.
NEON_PRODUCTION_HOST=ep-round-cell-b66do3rp-pooler.c-2.sa-east-1.aws.neon.tech
NEON_PRODUCTION_DATABASE_URL=
PRODUCTION_API_PORT=4474
PRODUCTION_BRIDGE_PORT=4475

# Gere uma chave NOVA de 32 bytes em base64url (não reaproveitar Preview).
# Mesma chave somente no gateway desta stack e na Function Vercel Production.
PRODUCTION_BRIDGE_KEY=
# Preencher depois de iniciar o túnel exclusivo. URL muda quando ele reinicia.
PRODUCTION_BRIDGE_ORIGIN=
# Referência para Vercel; Docker não liga/desliga a Function por este campo.
PRODUCTION_BRIDGE_ENABLED=false

# CADASTRAR NA VERCEL > Settings > Environment Variables > Production.
# Estes campos públicos abaixo são referências; backend Docker não os consome.
VITE_DEVELOPMENT_MODE=production
VITE_APP_RELEASE=configure-release
VITE_API_BASE_URL=
VITE_TELEMETRY_MODE=off
VITE_TELEMETRY_ENVIRONMENT=production
# Banco/Redis não vão para Vercel; PostHog permanece off até projeto confirmado.
