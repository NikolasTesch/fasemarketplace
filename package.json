{
  "name": "fasemarketplace",
  "version": "0.0.0",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "engines": { "node": ">=24.15 <25" },
  "scripts": {
    "dev:web": "npm run dev --workspace @fasemarketplace/web",
    "dev:api": "npm run dev:api --workspace @fasemarketplace/backend",
    "dev:worker": "npm run dev:worker --workspace @fasemarketplace/backend",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint packages/telemetry/index.js apps/backend/src apps/web/src apps/web/vite.config.ts",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "8.72.0"
  }
}
