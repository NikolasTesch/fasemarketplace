# Copiar para .env.access-recovery18 (privado/ignorado), sem herdar env Neon.
# Somente compose.recovery18.yaml + comandos de ensaio, nunca API/worker.
RECOVERY_POSTGRES_PASSWORD=
APP_ENV=local
MARKETPLACE_MODE=mock
DATABASE_PROVIDER=local
DATABASE_URL=
# DATABASE_URL: postgresql://fm_recovery_owner:SENHA_LOCAL@postgres/fm_auth_test_recovery
REDIS_URL=redis://redis:6379
AUTH_ENABLED=true
AUTH_CONTEXT=local
AUTH_ORIGIN=http://127.0.0.1:4773
AUTH_COOKIE_PREFIX=fm_recovery18_access
AUTH_SECRET=
# Somente para validação local do comando; não é uma API ativa nem cria essa role.
AUTH_DATABASE_URL=
# AUTH_DATABASE_URL: postgresql://fm_auth_runtime:SENHA_FICTICIA_LOCAL@postgres/fm_auth_test_recovery
