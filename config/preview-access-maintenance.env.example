# MODELO exclusivo para futura manutenção autorizada. Copie para
# .env.preview-access-maintenance (ignorado pelo Git). Não importar no Compose,
# na Vercel, no worker ou no frontend. Substitua TODOS os campos vazios.
APP_ENV=local
MARKETPLACE_MODE=mock
DATABASE_PROVIDER=neon
NEON_BRANCH=development
NEON_DEVELOPMENT_HOST=
REDIS_URL=redis://redis:6379
AUTH_ENABLED=true
AUTH_CONTEXT=preview
AUTH_ORIGIN=https://fasemarketplace-git-development-nikolasdtesch-4933s-projects.vercel.app
AUTH_COOKIE_PREFIX=fm_preview_access
AUTH_SECRET=
AUTH_API_KEY=
# Mesmo valor nas duas variáveis: runtime fm_auth_preview_runtime no endpoint
# pooled development confirmado, mesmo banco, query somente sslmode=verify-full.
DATABASE_URL=
AUTH_DATABASE_URL=
# Owner separado; endpoint DIRETO correspondente, sem -pooler no hostname.
# Mesmo banco, query somente sslmode=verify-full. Não usar owner produtivo.
PREVIEW_AUTH_OWNER_DATABASE_URL=
