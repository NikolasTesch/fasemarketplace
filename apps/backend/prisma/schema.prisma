generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["business"]
}

// SPEC-011. Authentication in public is managed separately and excluded.
model CatalogProduct {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @db.VarChar(120)
  description String           @default("") @db.VarChar(2000)
  iconName    String           @default("sports_soccer") @map("icon_name") @db.VarChar(64)
  salePrice   Decimal?         @map("sale_price") @db.Decimal(12, 2)
  cost        Decimal?         @db.Decimal(12, 2)
  active      Boolean          @default(true)
  version     Int              @default(1)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy   String           @map("created_by") @db.VarChar(128)
  updatedBy   String           @map("updated_by") @db.VarChar(128)
  variants    CatalogVariant[]

  @@index([createdAt, id])
  @@map("catalog_product")
  @@schema("business")
}

model CatalogVariant {
  id        String         @id @default(uuid()) @db.Uuid
  productId String         @map("product_id") @db.Uuid
  product   CatalogProduct @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  name      String         @db.VarChar(100)
  sku       String         @unique(map: "catalog_variant_sku_key") @db.VarChar(64)
  active    Boolean        @default(true)
  version   Int            @default(1)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String         @map("created_by") @db.VarChar(128)
  updatedBy String         @map("updated_by") @db.VarChar(128)
  stockPolicy VariantStockPolicy?
  stockMovements StockMovement[]

  @@index([productId, createdAt, id])
  @@map("catalog_variant")
  @@schema("business")
}

enum InventoryMode {
  SHARED
  SEPARATE

  @@map("inventory_mode")
  @@schema("business")
}

enum InventoryBucket {
  PHYSICAL_RESERVE
  SHARED_CHANNEL
  SHOPEE
  MERCADO_LIVRE

  @@map("inventory_bucket")
  @@schema("business")
}

enum StockMovementType {
  OPENING
  INBOUND
  OUTBOUND
  ADJUSTMENT
  TRANSFER

  @@map("stock_movement_type")
  @@schema("business")
}

model InventorySettings {
  id        Int           @id @default(1)
  mode      InventoryMode @default(SEPARATE)
  version   Int           @default(1)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String        @map("updated_by") @db.VarChar(128)

  @@map("inventory_settings")
  @@schema("business")
}

model VariantStockPolicy {
  variantId       String         @id @map("variant_id") @db.Uuid
  variant         CatalogVariant @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  minimumQuantity Int            @map("minimum_quantity")
  version         Int            @default(1)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy       String         @map("updated_by") @db.VarChar(128)

  @@map("variant_stock_policy")
  @@schema("business")
}

model StockMovement {
  id                String            @id @default(uuid()) @db.Uuid
  variantId         String            @map("variant_id") @db.Uuid
  variant           CatalogVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  movementType      StockMovementType @map("movement_type")
  sourceBucket      InventoryBucket?  @map("source_bucket")
  destinationBucket InventoryBucket?  @map("destination_bucket")
  quantity          Int
  reason            String?           @db.VarChar(500)
  idempotencyKey    String            @unique(map: "stock_movement_idempotency_key_key") @map("idempotency_key") @db.VarChar(160)
  createdBy         String            @map("created_by") @db.VarChar(128)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([variantId, createdAt, id])
  @@index([movementType, createdAt])
  @@map("stock_movement")
  @@schema("business")
}
