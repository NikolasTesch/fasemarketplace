# Somente desenvolvimento local. Copie para .env; não use segredos reais.
# Nome fixo por checkout; altere para isolar outro ambiente local.
COMPOSE_PROJECT_NAME=fasemarketplace-local
POSTGRES_DB=fasemarketplace
POSTGRES_USER=fasemarketplace
POSTGRES_PASSWORD=local-example-only
WEB_PORT=4173
API_PORT=4174
# Hosts abaixo são nomes de serviços Docker, não localhost.
DATABASE_URL=postgresql://fasemarketplace:local-example-only@postgres:5432/fasemarketplace
REDIS_URL=redis://redis:6379
# O bootstrap local não aceita modo real ou hosts externos.
APP_ENV=local
MARKETPLACE_MODE=mock

# Telemetria: off (padrão), console (somente local) ou posthog (envio externo).
# Não configurar PostHog produtivo no desenvolvimento.
TELEMETRY_MODE=off
WORKER_TELEMETRY_MODE=off
APP_RELEASE=development
# Preencher somente depois de criar/confirmar projeto de DESENVOLVIMENTO.
# Token público de ingestão phc_...; NUNCA usar Personal API Key ou Project Secret.
POSTHOG_PROJECT_TOKEN=
# Escolher a região do projeto: https://us.i.posthog.com ou https://eu.i.posthog.com
POSTHOG_HOST=

# DESENVOLVIMENTO HÍBRIDO: preencher manualmente, sem alterar DATABASE_URL acima.
# Usado somente por: docker compose -p fasemarketplace-hybrid -f compose.hybrid.yaml up -d --build --wait
# Neon > projeto > branch development > Connect > Connection pooling ON.
# Cole a conexão PostgreSQL e mantenha APENAS ?sslmode=verify-full na query.
# Exemplo fictício (não preencher com a branch production):
# postgresql://usuario:senha@ep-exemplo-pooler.sa-east-1.aws.neon.tech/fasemarketplace?sslmode=verify-full
NEON_DATABASE_URL=
# Mesmo hostname da conexão development, sem protocolo, porta ou caminho.
NEON_DEVELOPMENT_HOST=
HYBRID_API_PORT=4274
# Origem exata do frontend Vercel (https://nome.vercel.app), sem barra final.
# CORS não substitui autenticação; não abrir túnel público nesta etapa.
WEB_ALLOWED_ORIGINS=

# VERCEL: cadastrar no painel Settings > Environment Variables (não são segredos).
# Campo opcional para referência local; o Compose padrão não o injeta no Vite.
# API HTTPS protegida, sem /api e sem barra final. Não é URL de banco.
VITE_API_BASE_URL=
# Também cadastrar estes nomes públicos na Vercel quando ativar PostHog.
# São referências para configuração manual, não consumidos pelo Compose padrão.
VITE_TELEMETRY_MODE=off
VITE_TELEMETRY_ENVIRONMENT=preview
VITE_APP_RELEASE=development
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=
